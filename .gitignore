# macOS Finder metadata
.DS_Store
**/.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# Python (for src/golden/ when we write goldens)
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Cadence Stratus / HLS / EDA build artifacts
# tools/install.sh creates ~/architecture/build/ on the chamber for regenerable
# Stratus / Genus / Innovus output; never commit it.
build/
*.log
*.rpt
work/
INCA_libs/
# Stratus working dirs (per-config under src/blocks/<block>/stratus/)
*bdw_work/
*scverify_work/
*.bdw_work/
*.scverify_work/
# SimVision / Xcelium databases
*.shm/
xcelium.d/
xrun.history
xrun.key
xmsim.key
# Stratus IDE per-user state (lives next to project.tcl; don't commit)
.stratus/
*.stratus-prj/

# Secrets / runner-local config (NEVER commit)
.env
*.pem
*.key
.longhorn/

# Local Claude Code config and skills (per-developer, not shared)
.claude/
